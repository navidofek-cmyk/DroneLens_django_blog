# Zkopíruj do .env a vyplň hodnoty
DJANGO_SECRET_KEY=zmenit-na-silny-klic-v-produkci
DJANGO_DEBUG=True
DB_PASSWORD=dronepass
DOMAIN=localhost

# Obrázky — S3 / Cloudflare R2 / MinIO (nech prázdné pro lokální úložiště)
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION=eu-central-1
AWS_S3_CUSTOM_DOMAIN=          # volitelně CDN doména, např. cdn.droneview.cz
